# ---------------------------------------------------------------------------
# MindVoice · configuración por entorno
# ---------------------------------------------------------------------------
# Copia esto a `.env` (NO al repo: `.env` está en `.gitignore`) y rellena lo que
# necesites. Todo es opcional: sin ninguna variable la app arranca igual, pero
# sin `GEMINI_API_KEY` no hay voz ni búsqueda web.
#
# Windows (PowerShell), para el uso normal:
#     copy .env.example .env
#
# Las variables se leen al ARRANCAR. Si editas `.env` con la app abierta,
# ciérrala y vuelve a lanzarla.
# ---------------------------------------------------------------------------


# --- Clave de Gemini (obligatoria para usar el asistente) --------------------
# Se busca en este orden: GEMINI_API_KEY -> MINDVOICE_API_KEY -> almacén local
# cifrado (que rellenas en el primer arranque). Con una clave aquí no hace
# falta tocar nada más.
#
# OJO: el MODELO y la CALIDAD dependen del PLAN de esta clave, no del código.
# Una clave de pago que se queda sin cuota por minuto hace que el modelo de
# búsqueda caiga al de reserva (más barato) y las búsquedas se apaguen.
# MindVoice te lo dice en pantalla cuando pasa; mira también "(Arranque)" en el
# log de la consola.
GEMINI_API_KEY=

# Alias de la anterior, por si prefieres ese nombre (MINDVOICE_API_KEY gana si
# defines las dos).
MINDVOICE_API_KEY=


# --- Búsqueda web ------------------------------------------------------------
# Clave de serper.dev (https://serper.dev, 2.500 consultas/mes gratis, sin
# tarjeta). CON esta variable puesta, un clon limpio usa serper por defecto en
# vez de DuckDuckGo, que es la diferencia entre "las respuestas me suenan
# distintas" y "las respuestas me suenan distintas porqueDuckDuckGo me limita".
SERPER_API_KEY=

# Proxy SOLO para las búsquedas web. Útil si tu proveedor web bloquea tu país.
# Formato: http://127.0.0.1:8080 o socks5://user:pass@host:1080
# Sin esto se usan los proxies del entorno (HTTPS_PROXY/ALL_PROXY) o directa.
MINDVOICE_WEB_PROXY=


# --- Modelo de búsqueda (opcional) -------------------------------------------
# Si tu API no sirve el modelo por defecto (gemini-3.6-flash), puedes fijar otro
# nombre exacto. NO hace falta tocarlo: si el pin no está disponible para tu
# plan, la app lo dice y prueba el siguiente de la lista.
#
# En 2026 estos dan 404 "no longer available to new users" — no los uses:
#   gemini-2.5-flash, gemini-2.0-flash, gemini-3.1-flash-lite (sí sirve, pero
#   es el más barato: úsalo solo si buscas saving y aceptas peor respuesta)
# MINDVOICE_WEB_SEARCH_MODEL=


# --- Datos y diagnóstico ----------------------------------------------------
# Carpeta donde se guardan memoria, preferencias y cachés (por defecto la
# carpeta de datos de la app). Útil para tener varias instalaciones
# independientes, o para un clon de prueba totalmente separado.
MINDVOICE_DATA_DIR=

# Registro detallado en consola (protocolo de turnos de voz, red, visión).
# Útil para adjuntar un log al reportar un fallo.
MINDVOICE_DEBUG=


# --- Ciudad del clima -------------------------------------------------------
# Ciudad usada por el cmdlet del tiempo. Sin esto se pide por voz.
MINDVOICE_WEATHER_CITY=